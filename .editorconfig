root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

# Matches the flags lint.sh passes to shfmt.
[{bin/*,*.sh,hooks/*}]
switch_case_indent = true

[*.md]
indent_style = space
indent_size = 2
max_line_length = 80

[*.{yml,yaml}]
indent_style = space
indent_size = 2
