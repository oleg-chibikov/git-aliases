#!/usr/bin/env bash
# Create a branch, name normalized to lowercase-with-hyphens.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

args='<branch name>'
notes=(
	'the name is lowercased, and anything but a-z 0-9 / _ . - becomes a hyphen'
	'git cb "Fix the Parser!" creates fix-the-parser'
)

case ${1:-} in
	-h | --help) usage "$args" "${notes[@]}" ;;
esac

name=$(printf '%s' "$*" |
	tr '[:upper:]' '[:lower:]' |
	sed -E 's|[^a-z0-9/_.-]+|-|g; s/^-+|-+$//g; s/-+/-/g')

[ -n "$name" ] || usage "$args" "${notes[@]}"

run git checkout -b "$name"
