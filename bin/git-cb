#!/usr/bin/env bash
# Create a branch, name normalized to lowercase-with-hyphens.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

name=$(printf '%s' "$*" |
	tr '[:upper:]' '[:lower:]' |
	sed -E 's|[^a-z0-9/_.-]+|-|g; s/^-+|-+$//g; s/-+/-/g')

[ -n "$name" ] || die 'usage: git cb <branch name>'

run git checkout -b "$name"
