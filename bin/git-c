#!/usr/bin/env bash
# Commit: non-flag arguments are joined into the message, flags go to git commit.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

opts=()
message=()
for arg in "$@"; do
	case $arg in
		-*) opts+=("$arg") ;;
		*) message+=("$arg") ;;
	esac
done

[ ${#message[@]} -gt 0 ] || die 'usage: git c <message> [git commit flags]'

run git commit ${opts[@]+"${opts[@]}"} -m "${message[*]}"
