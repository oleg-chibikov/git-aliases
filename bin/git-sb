#!/usr/bin/env bash
# Pick a local branch with fzf and switch to it, worktrees included.
# A branch checked out in another worktree can't be switched to in place, so the
# path is printed as "__cd__ <path>" and the shell function from the README
# turns that into a real cd.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"
require fzf

here=$(git rev-parse --show-toplevel)

# "W<tab>branch<tab>worktree path" for every branch that a worktree holds.
worktree_branches() {
	git worktree list --porcelain |
		awk '/^worktree /{path = substr($0, 10)} /^branch refs\/heads\//{print "W\t" substr($0, 19) "\t" path}'
}

line=$(
	{
		worktree_branches
		git for-each-ref --sort=-committerdate --format='B%09%(refname:short)' refs/heads/
	} |
		awk -F'\t' -v here="$here" '
			$1 == "W" { worktree[$2] = $3; next }
			{
				path = worktree[$2]
				if (path == "") print $2
				else if (path == here) printf "%-50s \033[38;5;240m(this worktree)\033[0m\n", $2
				else printf "%-50s \033[38;5;240m%s\033[0m\n", $2, path
			}' |
		fzf --ansi --height=40% --reverse --prompt='branch> ' --preview "$fzf_preview"
) || exit 0

[ -n "$line" ] || exit 0
branch=${line%% *}

worktree=$(git worktree list --porcelain |
	awk -v ref="refs/heads/$branch" '
		/^worktree /{path = substr($0, 10)}
		/^branch /{if (substr($0, 8) == ref) {print path; exit}}')

if [ -n "$worktree" ] && [ "$worktree" != "$here" ]; then
	note "$branch is checked out at $worktree"
	printf '__cd__ %s\n' "$worktree"
	exit 0
fi

run git checkout "$branch"
