#!/usr/bin/env bash
# Stage all, commit, push.
# Flags: -f force-with-lease, -p skip hooks, -s skip staging.
# Everything after -- is message, even if it starts with a dash.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

push_opts=()
commit_opts=()
message=()
skip_add=''
rest_is_message=0

args='[-f] [-p] [-s] [--] <message>'
notes=(
	'-f  push with --force-with-lease'
	'-p  skip the commit and push hooks'
	'-s  skip staging, commit whatever is staged already'
	'--  makes everything after it message, even if it starts with a dash'
)

for arg in "$@"; do
	if [ "$rest_is_message" = 1 ]; then
		message+=("$arg")
		continue
	fi
	case $arg in
		-h | --help) usage "$args" "${notes[@]}" ;;
		--) rest_is_message=1 ;;
		-f) push_opts+=(--force-with-lease) ;;
		-p)
			commit_opts+=(--no-verify)
			push_opts+=(--no-verify)
			;;
		-s) skip_add=1 ;;
		-*)
			printf 'unknown flag: %s\n\n' "$arg" >&2
			usage "$args" "${notes[@]}"
			;;
		*) message+=("$arg") ;;
	esac
done

[ ${#message[@]} -gt 0 ] || usage "$args" "${notes[@]}"

[ -n "$skip_add" ] || run git add -A

if git diff --cached --quiet; then
	echo 'nothing to commit, pushing anyway'
else
	run git commit ${commit_opts[@]+"${commit_opts[@]}"} -m "${message[*]}"
fi

if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
	run git push ${push_opts[@]+"${push_opts[@]}"}
else
	run git push ${push_opts[@]+"${push_opts[@]}"} -u "$(default_remote)" HEAD
fi
