#!/usr/bin/env bash
# Pick branches and worktrees with fzf (TAB for several), then delete them.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"
require fzf

load_deletion_worktrees
candidates=$(deletion_candidates all)
[ -n "$candidates" ] || {
	echo 'No branches or worktrees to delete.'
	exit 0
}

selected=$(
	printf '%s\n' "$candidates" |
		fzf --multi --height=40% --reverse \
			--delimiter=$'\t' --with-nth=1,3.. \
			--header='TAB to multi-select, Enter to delete branches and worktree folders' \
			--preview "$fzf_preview"
) || exit 0

[ -n "$selected" ] || exit 0

delete_candidates "$selected"
