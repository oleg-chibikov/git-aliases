#!/usr/bin/env bash
# Fetch and rebase onto the default branch.
# -c rebases onto the upstream of the current branch, or pass a branch name.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

remote=$(default_remote)

case ${1:-} in
	-c) target='@{u}' ;;
	'') target="$remote/$(default_branch "$remote")" ;;
	-*) die "unknown flag: $1" ;;
	*) target="$remote/$1" ;;
esac

run git fetch "$remote"
run git rebase "$target"
