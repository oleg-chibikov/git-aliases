#!/usr/bin/env bash
# Prune remotes, then offer to delete branches and worktrees whose upstream is gone.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

run git fetch --prune

load_deletion_worktrees
selected=$(deletion_candidates gone)
if [ -z "$selected" ]; then
	echo 'No deletable branches or worktrees with a gone upstream.'
	exit 0
fi

echo 'Branches and worktrees whose remote branch was deleted:'
printf '%s\n' "$selected" | awk -F'\t' '{print "  " $1 " " $3}'
confirm 'Delete these branches and worktree folders?' || die 'aborted'

delete_candidates "$selected"
