#!/usr/bin/env bash
# Checkout a branch, fetching it from origin when it isn't local yet.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

args='<branch>'
notes=(
	'switches to the branch, or fetches it from the remote when it is not local yet'
)

case ${1:-} in
	-h | --help) usage "$args" "${notes[@]}" ;;
esac

branch=${1:-}
[ -n "$branch" ] || usage "$args" "${notes[@]}"

if git show-ref --verify --quiet "refs/heads/$branch"; then
	run git checkout "$branch"
else
	remote=$(default_remote)
	run git fetch "$remote" "$branch"
	run git checkout -b "$branch" "$remote/$branch"
fi
