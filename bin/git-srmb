#!/usr/bin/env bash
# Soft reset to the merge base with the default branch, keeping changes staged.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

remote=$(default_remote)
target="$remote/$(default_branch "$remote")"
base=$(git merge-base HEAD "$target")

run git reset --soft "$base"
