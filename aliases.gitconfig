[alias]
	sb = "!f() {\n  # Fuzzy-find local branches, each annotated with the worktree holding it, and switch to\n  # the selected one: checkout in place, or \"__cd__ <path>\" on stdout when it lives in\n  # another worktree.\n  #\n  # Setup:\n  #   1. brew install fzf\n  #   2. Add this to ~/.zshrc, so the \"__cd__\" line becomes a real cd (an alias runs in a\n  #      subprocess, so it cannot move its parent shell) and the VS Code window follows:\n  #        git() {\n  #          if [[ \"$1\" == \"sb\" ]]; then\n  #            shift\n  #            local out\n  #            out=$(command git sb \"$@\") || return\n  #            if [[ \"$out\" == \"__cd__ \"* ]]; then\n  #              local dir=${out#__cd__ }\n  #              cd \"$dir\" || return\n  #              if [[ \"$TERM_PROGRAM\" == \"vscode\" ]] && (( $+commands[code] )); then\n  #                code -r \"$dir\"\n  #              fi\n  #            fi\n  #          else\n  #            command git \"$@\"\n  #          fi\n  #        }\n  #      `code -r` needs the CLI on PATH: VS Code palette, \"Shell Command: Install 'code'\".\n  #   3. Optional: set \"git.detectWorktrees\": true so VS Code lists worktrees too.\n  # Without step 2 the alias still works, it just prints the path instead of going there.\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  local here; here=$(git rev-parse --show-toplevel) || return\n  local line; line=$(\n    { git worktree list --porcelain | awk '/^worktree /{p=substr($0,10)} /^branch refs\\/heads\\//{print \"W\\t\" substr($0,19) \"\\t\" p}';\n      git for-each-ref --sort=-committerdate --format=\"B%09%(refname:short)\" refs/heads/; } |\n    awk -F'\\t' -v here=\"$here\" '$1==\"W\"{w[$2]=$3; next} {p=w[$2]; if (p==\"\") print $2; else if (p==here) printf \"%-50s \\033[38;5;240m(this worktree)\\033[0m\\n\", $2; else printf \"%-50s \\033[38;5;240m%s\\033[0m\\n\", $2, p}' |\n    fzf --ansi --height=40% --reverse --prompt=\"branch> \" --preview \"git log -n 20 --color=always --date=short --pretty=format:\\\"%C(auto)%h %ad %an %s\\\" {1}\"\n  ) || return\n  [ -n \"$line\" ] || return\n  local branch; branch=${line%% *}\n  local wt; wt=$(git worktree list --porcelain | awk -v b=\"refs/heads/$branch\" '/^worktree /{p=substr($0,10)} /^branch /{if (substr($0,8)==b) {print p; exit}}')\n  if [ -n \"$wt\" ] && [ \"$wt\" != \"$here\" ]; then\n    printf \"\\033[1;33m+\\033[0m \\033[1;36m%s is checked out at %s\\033[0m\\n\" \"$branch\" \"$wt\" >&2\n    printf \"__cd__ %s\\n\" \"$wt\"\n    return 0\n  fi\n  run git checkout \"$branch\"\n}; f"
	db = "!f() {\n  # Fuzzy-find local branches (excluding current), multi-select with TAB, and force-delete selected\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  local branches; branches=$(git for-each-ref --sort=-committerdate --format=\"%(refname:short)\" refs/heads/ | grep -v \"^$(git symbolic-ref --short HEAD 2>/dev/null)$\" | fzf -m --height=40% --reverse --header=\"TAB to multi-select, Enter to force-delete\" --preview \"git log -n 20 --color=always --date=short --pretty=format:\\\"%C(auto)%h %ad %an %s\\\" {}\") && [ -n \"$branches\" ] && echo \"$branches\" | while IFS= read -r b; do run git branch -D \"$b\"; done; }; f"
	master = "!f() {\n  # Discard local changes (with prompt), fetch origin, then hard-reset to master or main\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; };\n  if ! git rev-parse --git-dir >/dev/null 2>&1; then\n    echo \"Not a git repository\" >&2; return 1;\n  fi\n  if [ -n \"$(git status --porcelain)\" ]; then\n    echo \"You have local changes:\";\n    git status --short;\n    printf \"Drop all local changes? [y/N] \";\n    read ans </dev/tty;\n    case \"$ans\" in\n      y|Y|yes|YES)\n        run git reset --hard HEAD && run git clean -fd;;\n      *)\n        echo \"Aborted.\"; return 1;;\n    esac\n  fi\n  if git show-ref --verify --quiet refs/heads/master; then\n    branch=master;\n  elif git show-ref --verify --quiet refs/heads/main; then\n    branch=main;\n  else\n    echo \"Neither local master nor main exists\" >&2; return 1;\n  fi\n  if git show-ref --verify --quiet refs/remotes/origin/master; then\n    remote=origin/master;\n  elif git show-ref --verify --quiet refs/remotes/origin/main; then\n    remote=origin/main;\n  else\n    echo \"Neither origin/master nor origin/main exists\" >&2; return 1;\n  fi\n  run git fetch origin \"${remote#origin/}\" && run git checkout \"$branch\" && run git reset --hard \"$remote\";\n}; f"
	cp = "!f() {\n  # Stage all, commit with message, and push; flags: -f=force-with-lease, -p=skip-hooks, -s=skip-stage\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  force=\"\"; verify=\"\"; skip_add=\"\"; msg_parts=\"\";\n  for arg in \"$@\"; do\n    case \"$arg\" in\n      -f) force=\"--force-with-lease\" ;;\n      -p) verify=\"--no-verify\" ;;\n      -s) skip_add=1 ;;\n      -*) echo \"unknown flag: $arg\" >&2; return 1 ;;\n      *) if [ -z \"$msg_parts\" ]; then msg_parts=\"$arg\"; else msg_parts=\"$msg_parts $arg\"; fi ;;\n    esac\n  done\n  msg=\"$msg_parts\"\n  if [ -z \"$msg\" ]; then echo \"usage: git cp [-f] [-p] [-s] <message>\" >&2; return 1; fi\n  if [ -z \"$skip_add\" ]; then run git add -A || return $?; fi\n  if git diff --cached --quiet; then\n    echo \"nothing to commit, pushing anyway\";\n  else\n    run git commit $verify -m \"$msg\" || return $?\n  fi\n  if git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1; then\n    run git push $force\n  else\n    run git push $force -u origin HEAD\n  fi\n}; f"
	sr1 = "!f() {\n  # Undo the last commit but keep its changes staged (soft reset to HEAD~1)\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  run git reset --soft HEAD~1;\n}; f"
	dbm = "!f() {\n  # Prune remote refs, find local branches whose upstream is gone (squash-merged), and prompt to delete them\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  run git fetch --prune;\n  gone=$(git for-each-ref --format=\"%(refname:short) %(upstream:track)\" refs/heads/ | awk \"/\\[gone\\]/ {print \\$1}\");\n  if [ -z \"$gone\" ]; then echo \"No local branches with a gone upstream.\"; return 0; fi;\n  echo \"Local branches whose remote was deleted (likely squash-merged):\";\n  echo \"$gone\" | sed \"s/^/  /\";\n  printf \"Delete these? [y/N] \";\n  read ans;\n  case \"$ans\" in y|Y|yes|YES) ;; *) echo \"Aborted.\"; return 1 ;; esac;\n  echo \"$gone\" | while IFS= read -r b; do run git branch -D \"$b\"; done;\n}; f"
	b = "!f() {\n  # Print the current branch name\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  run git rev-parse --abbrev-ref HEAD;\n}; f"
	cb = "!f() {\n  # Create a new branch normalizing the given name to lowercase hyphenated format\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  name=$(echo \"$*\" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9/_.-]+/-/g; s/^-+|-+$//g; s/-+/-/g'); if [ -z \"$name\" ]; then echo 'usage: git cb <branch name>' >&2; return 1; fi; run git checkout -b \"$name\"; }; f"
	a = "!f() {\n  # List all git aliases with syntax-highlighted output, showing comments in yellow\n  cols=$(tput cols 2>/dev/null || echo 80)\n  sep_thin=$(printf '%*s' \"$cols\" '' | tr ' ' '-')\n  sep_thick=$(awk -v n=\"$cols\" 'BEGIN{for(i=0;i<n;i++) printf \"━\"; print \"\"}')\n  git config --global --name-only --get-regexp \"^alias\\.\" | cut -d. -f2 | sort | while read -r name; do\n    code=$(git config --global \"alias.$name\")\n    printf \"\\033[1;36m%-20s\\033[0m \" \"$name\"\n    printf \"\\033[90m│\\033[0m\\n\"\n    printf \"%s\\n\" \"$code\" | while IFS= read -r line; do\n      if printf \"%s\" \"$line\" | grep -qE \"^\\s*#\"; then\n        printf \"  \\033[38;5;220m%s\\033[0m\\n\" \"$line\"\n      else\n        printf \"  %s\\n\" \"$line\"\n      fi\n    done\n    printf \"\\n\"\n    printf \"\\033[38;5;240m%s\\033[0m\\n\" \"$sep_thin\"\n    printf \"\\033[38;5;240m%s\\033[0m\\n\" \"$sep_thick\"\n    printf \"\\033[38;5;240m%s\\033[0m\\n\" \"$sep_thin\"\n    printf \"\\n\"\n  done\n}; f"
	hr = "!f() {\n  # Hard reset to HEAD and delete all untracked files and directories\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  run git reset --hard HEAD && run git clean -fd;\n}; f"
	r = "!f() {\n  # Fetch from origin and rebase onto master/main by default, @{u} with -c, or a named branch\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  if [ \"$1\" = \"-c\" ]; then\n    target=@{u};\n  elif [ -n \"$1\" ]; then\n    target=\"origin/$1\";\n  elif git show-ref --verify --quiet refs/remotes/origin/master; then\n    target=origin/master;\n  elif git show-ref --verify --quiet refs/remotes/origin/main; then\n    target=origin/main;\n  else\n    echo \"Neither origin/master nor origin/main found\" >&2; return 1;\n  fi;\n  run git fetch origin && run git rebase \"$target\";\n}; f"
	dwm = "!f() {\n  # Prune remote refs, find worktrees whose upstream branch is gone (squash-merged), and prompt to remove them (also deletes local branch)\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  run git fetch --prune;\n  gone=$(git for-each-ref --format=\"%(refname:short) %(upstream:track)\" refs/heads/ | awk \"/\\[gone\\]/ {print \\$1}\");\n  if [ -z \"$gone\" ]; then echo \"No worktrees with a gone upstream.\"; return 0; fi;\n  to_remove=$(\n    git worktree list | tail -n +2 | grep '\\[' | grep -v ' locked$' | while read -r wt _hash brack; do\n      branch=$(printf '%s' \"$brack\" | tr -d '[]');\n      printf '%s\\n' \"$gone\" | grep -qxF \"$branch\" && printf '%s|%s\\n' \"$wt\" \"$branch\";\n    done\n  );\n  if [ -z \"$to_remove\" ]; then echo \"No worktrees with a gone upstream.\"; return 0; fi;\n  echo \"Worktrees whose remote branch was deleted (likely squash-merged):\";\n  printf '%s\\n' \"$to_remove\" | awk -F'|' '{print \"  \" $1 \" [\" $2 \"]\"}';\n  printf \"Remove these worktrees and delete their local branches? [y/N] \";\n  read ans;\n  case \"$ans\" in y|Y|yes|YES) ;; *) echo \"Aborted.\"; return 1 ;; esac;\n  printf '%s\\n' \"$to_remove\" | while IFS='|' read -r wt branch; do\n    run git worktree remove \"$wt\";\n    run git branch -D \"$branch\";\n  done;\n}; f"
	co = "!f() { branch=\"${1:?Usage: git co <branch-name>}\"; if git branch --list \"$branch\" | grep -q .; then git checkout \"$branch\"; else git fetch origin \"$branch\" && git checkout -b \"$branch\" \"origin/$branch\"; fi; }; f"
	p = "!f() {\n  # Pull (rebase) from origin the remote branch matching the current branch\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  run git pull --rebase origin \"$(git rev-parse --abbrev-ref HEAD)\";\n}; f"
	last = "!f() {\n  # Show the last commit message and its diff\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  run git show HEAD;\n}; f"
	main = !git master
	m = !git master
	c = "!f() {\n  # Commit with a message: non-flag args are joined into the -m message, flags are passed through to git commit\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  opts=\"\"; msg_parts=\"\";\n  for arg in \"$@\"; do\n    case \"$arg\" in\n      -*) if [ -z \"$opts\" ]; then opts=\"$arg\"; else opts=\"$opts $arg\"; fi ;;\n      *) if [ -z \"$msg_parts\" ]; then msg_parts=\"$arg\"; else msg_parts=\"$msg_parts $arg\"; fi ;;\n    esac\n  done\n  if [ -z \"$msg_parts\" ]; then echo \"usage: git c <message> [git commit flags]\" >&2; return 1; fi\n  run git commit $opts -m \"$msg_parts\";\n}; f"
	srmb = "!f() {\n  # Soft reset the current branch to its merge base with master/main, keeping changes staged\n  run() { printf \"\\033[1;33m+\\033[0m \\033[1;36m%s\\033[0m\\n\" \"$*\" >&2; \"$@\"; }\n  if git show-ref --verify --quiet refs/remotes/origin/master; then\n    target=origin/master;\n  elif git show-ref --verify --quiet refs/remotes/origin/main; then\n    target=origin/main;\n  else\n    echo \"Neither origin/master nor origin/main found\" >&2; return 1;\n  fi;\n  base=$(git merge-base HEAD \"$target\") && run git reset --soft \"$base\";\n}; f"
